# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/urlshortener?retryWrites=true&w=majority

# Local Application Port
PORT=3000

# Base URL for generated short links
BASE_URL=http://localhost:3000

# Distributed Redis Cache (Optional for single instance; automated in Docker Compose)
# REDIS_URL=redis://localhost:6379
